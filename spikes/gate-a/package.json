{
  "name": "melos-gate-a-spike",
  "version": "0.0.0",
  "private": true,
  "description": "Gate A compatibility spike: Better Auth (org) -> Next.js + CopilotKit -> AG-UI -> Mastra agent -> libSQL, with AIMock serving every LLM call.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "aimock": "aimock -c aimock.json",
    "db:push": "drizzle-kit push",
    "smoke:channels": "node scripts/channels-smoke.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@ag-ui/mastra": "1.1.3",
    "@ai-sdk/openai": "4.0.66",
    "@copilotkit/channels": "0.9.2",
    "@copilotkit/react-core": "1.71.1",
    "@copilotkit/react-ui": "1.71.1",
    "@copilotkit/runtime": "1.71.1",
    "@libsql/client": "0.18.0",
    "@mastra/client-js": "1.45.0",
    "@mastra/core": "1.66.0",
    "@mastra/libsql": "1.22.5",
    "@mastra/memory": "1.29.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.41.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.4",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
