{
  "name": "melos",
  "version": "0.0.0",
  "private": true,
  "description": "Melos: music catalog, rights/splits and pitching CRM with an agent-native chat UI.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write --unsafe .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "aimock": "aimock -c aimock.json",
    "auth:generate": "auth generate --config src/server/auth/auth.ts --output src/server/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:fk-rules": "node src/server/db/fk-rules.ts",
    "db:workspace-tables": "node src/server/db/workspace-tables.ts",
    "db:workspace-migrations": "node src/server/db/embed-workspace-migrations.ts",
    "db:migrate-workspaces": "tsx --env-file-if-exists=.env.local scripts/migrate-workspaces.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "db:validate-demo": "tsx --env-file-if-exists=.env.local scripts/validate-demo.ts",
    "workspace:provision": "tsx --env-file-if-exists=.env.local scripts/workspace-provision.ts"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@ag-ui/mastra": "1.1.3",
    "@ai-sdk/gateway": "3.0.193",
    "@base-ui/react": "1.8.0",
    "@better-auth/core": "1.7.4",
    "@copilotkit/react-core": "1.71.1",
    "@copilotkit/react-ui": "1.71.1",
    "@copilotkit/runtime": "1.71.1",
    "@libsql/client": "0.18.0",
    "@libsql/core": "0.18.0",
    "@mastra/client-js": "1.45.0",
    "@mastra/core": "1.66.0",
    "@mastra/libsql": "1.22.5",
    "@mastra/memory": "1.29.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-auth": "1.7.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "ulid": "3.0.2",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@copilotkit/aimock": "1.41.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.4",
    "drizzle-kit": "0.31.10",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
