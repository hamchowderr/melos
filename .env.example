# Melos environment contract. Placeholders only: never commit real values.
# Copy to .env.local for local development. Secrets are injected at runtime.

# --- Auth (Better Auth) -------------------------------------------------------
# Required. At least 32 characters.
BETTER_AUTH_SECRET=YOUR_SECRET_HERE
# Optional. Unset on Vercel falls back to https://$VERCEL_BRANCH_URL, then https://$VERCEL_URL.
# Local default: http://localhost:3100
BETTER_AUTH_URL=

# --- Control plane: Better Auth users, sessions, workspaces --------------------
# Local default: file:./data/control.db (no token). Vercel: remote libSQL URL + token required.
MELOS_CONTROL_DATABASE_URL=
MELOS_CONTROL_DATABASE_AUTH_TOKEN=

# --- Agent runtime storage: Mastra threads and memory (separate database) ------
# Local default: file:./data/agent.db (no token). Vercel: remote libSQL URL + token required.
MELOS_AGENT_DATABASE_URL=
MELOS_AGENT_DATABASE_AUTH_TOKEN=

# --- Chat model ---------------------------------------------------------------
# Mastra model router string. Previews use the Mastra Gateway, for example:
#   MELOS_CHAT_MODEL=mastra/anthropic/claude-haiku-4.5
MELOS_CHAT_MODEL=
# Read by the Mastra model router for mastra/* models.
MASTRA_GATEWAY_API_KEY=YOUR_KEY_HERE

# Test-only. Serves the chat model from an OpenAI-compatible mock (AIMock) with a dummy key.
# When set, MELOS_CHAT_MODEL is ignored. Rejected on Vercel.
# MELOS_LLM_BASE_URL=http://127.0.0.1:4010/v1

# --- Email (contract name, not used yet) ---------------------------------------
MELOS_EMAIL_TRANSPORT=sandbox
# Auth email mailer: outbox writes JSON to .data/auth-outbox/, memory keeps it in process (tests).
# Production (VERCEL_ENV=production) refuses to start with either development mailer.
MELOS_AUTH_MAILER=outbox

# --- Telemetry ----------------------------------------------------------------
COPILOTKIT_TELEMETRY_DISABLED=true
